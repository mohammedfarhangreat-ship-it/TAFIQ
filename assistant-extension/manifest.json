{
  "manifest_version": 3,
  "name": "Tafiq Voice Assistant",
  "short_name": "Tafiq",
  "version": "1.0.0",
  "description": "Always-on personal voice assistant for ChromeOS. Say \"Hey Tafiq\" to open apps, manage tabs, set reminders and ask anything.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tafiq Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "commands": {
    "wake": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "chromeos": "Alt+Shift+T"
      },
      "description": "Wake Tafiq and start listening"
    }
  },
  "permissions": [
    "alarms",
    "management",
    "notifications",
    "scripting",
    "search",
    "sidePanel",
    "storage",
    "tabs",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
